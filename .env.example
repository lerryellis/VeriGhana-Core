# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=eyJ...           # anon/public key
SUPABASE_SERVICE_KEY=eyJ...   # service_role key (never expose client-side)
SUPABASE_JWT_SECRET=          # from Supabase Dashboard > Settings > API

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET_KEY=                # random 64-char hex string
JWT_REFRESH_SECRET=            # different random 64-char hex string
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_API_KEY=                 # random token — must match ADMIN_API_KEY in Next.js

# ── AI providers ─────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=                  # optional fallback
COHERE_API_KEY=                # optional fallback
OPENROUTER_API_KEY=            # optional fallback

# ── Email / SMS ───────────────────────────────────────────────
RESEND_API_KEY=                # for support replies + payment receipts

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://app.verighana.com,https://verighana.com
